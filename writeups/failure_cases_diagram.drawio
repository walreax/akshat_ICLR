<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Failure Cases" id="failcases-page-1">
    <mxGraphModel dx="1600" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== Top banner ===== -->
        <mxCell id="banner1" value="Failure Cases of Existing (External) Metrics on Creative Prompts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="1560" height="45" as="geometry" />
        </mxCell>
        <mxCell id="sub1" value="Common evaluation metrics (CLIP, BLIP VQA, Inception Score) often score semantically incorrect, generic, or low-quality images highly. Below: three real generations from our own calibration set (SD3 / PixArt-α, seed 42), viewed through each metric." style="text;html=0;align=center;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="20" y="58" width="1560" height="28" as="geometry" />
        </mxCell>

        <!-- ===== Column 1: CLIP ===== -->
        <mxCell id="col1" value="1. CLIP Image–Text Similarity" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="20" y="98" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="col1_desc" value="Measures global similarity between image and text embeddings. Often relies on surface-level keyword/object alignment, not narrative meaning." style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="460" height="42" as="geometry" />
        </mxCell>
        <mxCell id="col1_prompt" value="Prompt (poem excerpt):&#10;&quot;The mountain and the squirrel had a quarrel, and the former called the latter ‘Little prig.’&quot; &#8212; The Mountain and the Squirrel, Emerson" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;fontStyle=2;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="178" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="col1_concepts" value="Concrete nouns in the poem:&#10;mountain, squirrel, nut, forests, track" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10.5;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="270" y="178" width="210" height="95" as="geometry" />
        </mxCell>

        <mxCell id="col1_img_a" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="288" width="140" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col1_cap_a" value="(a) SD3 &#8212; mountain + squirrel, both present (CLIP 0.192)" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col1_score_a" value="CLIP: 0.192" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9.5;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="381" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col1_img_b" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="288" width="140" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col1_cap_b" value="(b) PixArt-α, same prompt &#8212; on-topic, dialogue has no visual form (CLIP 0.203)" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="190" y="325" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col1_score_b" value="CLIP: 0.203" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9.5;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="190" y="381" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col1_img_c" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="288" width="140" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col1_cap_c" value="(c) SD3 &#8212; abstract poem (Szymborska): no concrete nouns (CLIP 0.223, highest!)" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="340" y="325" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col1_score_c" value="CLIP: 0.223" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9.5;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="340" y="381" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col1_obs" value="Observation (real CLIP scores, imageMetric/evaluate_models.py, n=600 calibration prompts):&#10;&#8226; the abstract, content-free image (c) scores highest of the three (0.223) &#8212; higher than either well-matched concrete image (0.192, 0.203)&#10;&#8226; CLIP has no way to know (c) failed to depict anything &#8212; it just sees an image with legible-looking marks and text-shaped structure" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="40" y="413" width="440" height="100" as="geometry" />
        </mxCell>

        <!-- ===== Column 2: BLIP VQA ===== -->
        <mxCell id="col2" value="2. BLIP VQA / Captioning Consistency" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="540" y="98" width="500" height="470" as="geometry" />
        </mxCell>
        <mxCell id="col2_desc" value="Uses a vision-language model to answer questions or generate captions. Often focuses on visible objects/attributes, ignoring poetic or narrative intent." style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="460" height="42" as="geometry" />
        </mxCell>
        <mxCell id="col2_prompt" value="Same three generations as column 1 (poem prompts, not a story &#8212; our calibration set is 400 tiny_story + 200 poem_sum; these three happen to be poems)." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10.5;fontStyle=2;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="560" y="178" width="220" height="95" as="geometry" />
        </mxCell>
        <mxCell id="col2_questions" value="Example VQA questions:&#10;Is there a mountain? How many squirrels? Is the text on the page legible?" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#82b366;fontSize=10.5;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="790" y="178" width="210" height="95" as="geometry" />
        </mxCell>

        <mxCell id="col2_img_a" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="288" width="140" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col2_cap_a" value="(a) SD3 &#8212; mountain + squirrel, both visible (VQAScore 0.346)" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="560" y="325" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col2_score_a" value="VQAScore: 0.346" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9.5;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="560" y="381" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col2_img_b" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="288" width="140" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col2_cap_b" value="(b) PixArt-α &#8212; mountain faint, easy for VQA to miss (VQAScore 0.395)" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="710" y="325" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col2_score_b" value="VQAScore: 0.395" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9.5;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="710" y="381" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col2_img_c" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="288" width="140" height="105" as="geometry" />
        </mxCell>
        <mxCell id="col2_cap_c" value="(c) SD3 &#8212; page of illegible pseudo-text (VQAScore 0.602, highest!)" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="860" y="325" width="140" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col2_score_c" value="VQAScore: 0.602" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9.5;align=center;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="860" y="381" width="140" height="24" as="geometry" />
        </mxCell>

        <mxCell id="col2_obs" value="Observation (real VQAScore, t2v_metrics clip-flant5-xl, same n=600 run):&#10;&#8226; same pattern as CLIP &#8212; (c) scores highest (0.602) despite having no depictable content; (a)/(b) score lower (0.346, 0.395) despite being faithful&#10;&#8226; BLIP-2 ITM shows an even starker version of this: 0.930 / 0.999 for (a)/(b) vs 0.9999 for (c) &#8212; near-perfect score for the failure case" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="560" y="413" width="460" height="90" as="geometry" />
        </mxCell>

        <!-- ===== Column 3: Inception Score ===== -->
        <mxCell id="col3" value="3. Inception Score (IS)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1060" y="98" width="520" height="470" as="geometry" />
        </mxCell>
        <mxCell id="col3_desc" value="Measures image quality and diversity using a pretrained image classifier, over a whole batch of images at once. Not conditioned on the text prompt at all." style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1080" y="130" width="480" height="42" as="geometry" />
        </mxCell>

        <mxCell id="col3_img_a" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="182" width="150" height="112" as="geometry" />
        </mxCell>
        <mxCell id="col3_cap_a" value="(a) SD3 — mountain + squirrel" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1080" y="299" width="150" height="48" as="geometry" />
        </mxCell>
        <mxCell id="col3_is_banner" value="Inception Score is computed once over all n=600 SD3 images, not per image: 15.13 &#177; 2.90 &#8212; identical number for (a), (b), and (c)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9.5;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1080" y="351" width="480" height="40" as="geometry" />
        </mxCell>

        <mxCell id="col3_img_b" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1245" y="182" width="150" height="112" as="geometry" />
        </mxCell>
        <mxCell id="col3_cap_b" value="(b) PixArt-α, same prompt" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1245" y="299" width="150" height="48" as="geometry" />
        </mxCell>
        

        <mxCell id="col3_img_c" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1410" y="182" width="150" height="112" as="geometry" />
        </mxCell>
        <mxCell id="col3_cap_c" value="(c) SD3 — abstract poem, pseudo-text" style="text;html=0;align=center;verticalAlign=top;fontSize=9.5;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1410" y="299" width="150" height="48" as="geometry" />
        </mxCell>
        

        <mxCell id="col3_obs" value="Observation (real Inception Score, torchmetrics, n=600 SD3 generations):&#10;&#8226; IS cannot flag (c) at all &#8212; it is not a per-image number, so it structurally cannot distinguish a faithful generation from a content-free one&#10;&#8226; a model can average 15.13 &#177; 2.90 and still fail on any individual, specific prompt" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1080" y="393" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="col3_note" value="scores throughout this panel are real (imageMetric/evaluate_models.py, evaluate_vqascore.py, evaluate_inception.py against the full 600-prompt calibration set)" style="text;html=0;align=left;verticalAlign=top;fontSize=9;fontColor=#999999;fontStyle=2;whiteSpace=wrap;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="1080" y="462" width="480" height="34" as="geometry" />
        </mxCell>

        <!-- ===== Key Takeaways ===== -->
        <mxCell id="takeaways" value="Key Takeaways&#10;• existing metrics (CLIP, BLIP, Inception Score) often fail to capture the deeper semantics, narrative elements, and creative intent of story/poem-based generation&#10;• high scores are achievable for semantically incorrect, incomplete, or even low-quality images&#10;• none of these look inside the model — they score outputs only, never the internal representations that produced them" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;verticalAlign=middle;spacing=10;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="20" y="585" width="1560" height="105" as="geometry" />
        </mxCell>

        <!-- ===== Bottom banner ===== -->
        <mxCell id="banner2" value="Motivation: Leverage Model Internals for a More Reliable and Meaningful Evaluation Metric" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f4e8c;strokeColor=none;fontColor=#ffffff;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="20" y="710" width="1560" height="55" as="geometry" />
        </mxCell>

        <mxCell id="e_take" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="takeaways" target="banner2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_col1_take" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.16;entryY=0;" edge="1" parent="1" source="col1" target="takeaways">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_col2_take" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="col2" target="takeaways">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_col3_take" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=none;strokeColor=#666666;exitX=0.5;exitY=1;entryX=0.84;entryY=0;" edge="1" parent="1" source="col3" target="takeaways">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
