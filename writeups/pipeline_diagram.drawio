        </mxCell>
        <mxCell id="c3_sub" value="Each generated image is re-passed through the MMDiT model; a forward hook reads activations at selected transformer blocks and encodes them with that block's trained SAE." style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
