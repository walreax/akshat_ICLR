        <mxCell id="e_c3_map" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#9673a6;" edge="1" parent="1" source="c3_s4" target="c3_map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="4. Compute Per-Block Statistics" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1190" y="75" width="390" height="430" as="geometry" />
        </mxCell>
        <mxCell id="c4a_h" value="(a) Mean Centroid and Deviation" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1210" y="100" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c4a_plot" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="125" width="160" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c4a_formula" value="&lt;i&gt;D&lt;/i&gt;&lt;sub&gt;l&lt;/sub&gt; = (1/N) &#183; &#931;&lt;sub&gt;i&lt;/sub&gt; &#8214;&lt;i&gt;h&lt;/i&gt;&lt;sub&gt;l,i&lt;/sub&gt; &#8722; &#956;&lt;sub&gt;l&lt;/sub&gt;&#8214;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=15;fontFamily=Georgia;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1385" y="125" width="175" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c4a_cap" value="mean deviation of block-l features from their own centroid μ_l" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1385" y="245" width="175" height="40" as="geometry" />
        </mxCell>

        <mxCell id="c4b_h" value="(b) Attention Concentration" style="text;html=0;align=left;verticalAlign=top;fontSize=12;fontStyle=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1210" y="300" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="c4b_plot" value="" style="shape=image;image=data:image/jpeg,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1210" y="325" width="160" height="115" as="geometry" />
        </mxCell>
        <mxCell id="c4b_formula" value="&lt;i&gt;A&lt;/i&gt;&lt;sub&gt;l&lt;/sub&gt; = 1 &#8722; H(map&lt;sub&gt;l&lt;/sub&gt;)/H&lt;sub&gt;max&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;fontSize=14;fontFamily=Georgia;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1385" y="325" width="175" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c4b_cap" value="Shannon entropy of the latent&#39;s normalized 32&#215;32 activation map; low entropy (peaked) &#8594; high A_l" style="text;html=0;align=left;verticalAlign=top;fontSize=10;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1385" y="445" width="175" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4_note" value="real columns today: concentration, centroid_x/y in concept_metrics.csv" style="text;html=0;align=left;verticalAlign=top;fontSize=9;fontColor=#999999;fontStyle=2;whiteSpace=wrap;fontFamily=Consolas;" vertex="1" parent="1">
          <mxGeometry x="1210" y="490" width="350" height="15" as="geometry" />
        </mxCell>

        <!-- Row 1 sequential arrows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#666666;strokeWidth=2;" edge="1" parent="1" source="c1" target="c2">
