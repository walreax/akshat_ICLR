        <mxCell id="t_title" value="From Words to Images: An Internal-Representation Based Evaluation Pipeline for Creative Text-to-Image Generation" style="text;html=0;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
