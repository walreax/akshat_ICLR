        <mxCell id="c1_card_1" value="prompt 1 — The Definition of Love (Marvell)&#10;&#10;&quot;My love is of a birth as rare / As 'tis for object strange and high; / It was begotten by Despair / Upon Impossibility.&quot;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
