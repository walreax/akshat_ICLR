        <mxCell id="c3_map_cap" value="real latent map&#10;(block 12, t=0.5)" style="text;html=0;align=left;verticalAlign=top;fontSize=8;fontColor=#9673a6;fontStyle=2;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1088" y="277" width="80" height="26" as="geometry" />
