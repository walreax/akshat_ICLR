        <mxCell id="c1_card_3" value="prompt 3 — This Is Just To Say (W. C. Williams)&#10;&#10;&quot;I have eaten the plums that were in the icebox... Forgive me they were delicious, so sweet and so cold.&quot;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
