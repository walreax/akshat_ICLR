        <mxCell id="c1_card_2" value="prompt 2 — Constancy (Brodsky)&#10;&#10;&quot;Constancy is an evolution of one's living quarters into a thought: a continuation of a parallelogram or a rectangle...&quot;" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;spacing=6;fontFamily=Segoe UI;" vertex="1" parent="1">
