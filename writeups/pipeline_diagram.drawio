        <!-- ===== Box 5: Aggregate Across Blocks ===== -->
        <mxCell id="c5" value="5. Aggregate Across Blocks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="20" y="565" width="500" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c5_t1" value="Mean Deviation Across Blocks" style="text;html=0;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="50" y="590" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c5_f1" value="D&#772; = (1/L) &#183; &#931;&lt;sub&gt;l&lt;/sub&gt; &lt;i&gt;D&lt;/i&gt;&lt;sub&gt;l&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;fontFamily=Georgia;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="615" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c5_c1" value="Average representation deviation across the selected blocks (e.g. 4, 8, 12, 16, 20)." style="text;html=0;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="678" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="c5_div" style="endArrow=none;html=1;strokeColor=#c3d9c3;strokeWidth=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="735" as="sourcePoint" />
            <mxPoint x="490" y="735" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c5_t2" value="Mean Attention Concentration Across Blocks" style="text;html=0;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="50" y="750" width="440" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c5_f2" value="A&#772; = (1/L) &#183; &#931;&lt;sub&gt;l&lt;/sub&gt; &lt;i&gt;A&lt;/i&gt;&lt;sub&gt;l&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=17;fontFamily=Georgia;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="775" width="440" height="55" as="geometry" />
        </mxCell>
        <mxCell id="c5_c2" value="Average entropy-based concentration across the same selected blocks (higher = more spatially peaked)." style="text;html=0;align=center;verticalAlign=top;fontSize=11;fontColor=#666666;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="70" y="838" width="400" height="40" as="geometry" />
        </mxCell>

        <!-- ===== Box 6: Final Metric Computation ===== -->
        <mxCell id="c6" value="6. Final Metric Computation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="540" y="565" width="420" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c6_formula" value="&lt;i&gt;M&lt;/i&gt; = &#945; &#183; (1 &#8722; D&#772;) + &#946; &#183; A&#772;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=22;fontStyle=1;fontFamily=Georgia;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="570" y="615" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="c6_weights" value="α, β are fixed a priori weighting factors (e.g. α=0.5, β=0.5) — never fit on human ratings." style="text;html=0;align=center;verticalAlign=top;fontSize=10;fontColor=#666666;whiteSpace=wrap;fontStyle=2;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="570" y="712" width="360" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c6_note" value="Higher M indicates better alignment of internal representations with the semantics of the creative text — i.e. more coherent, more interpretable image generation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#b85450;dashed=1;fontSize=11;align=center;verticalAlign=middle;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="570" y="756" width="360" height="140" as="geometry" />
        </mxCell>

        <!-- ===== Box 7: Analyze Variations ===== -->
        <mxCell id="c7" value="7. Analyze Variations Across Seeds and Blocks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=13;fontStyle=1;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="980" y="565" width="600" height="380" as="geometry" />
        </mxCell>
        <mxCell id="c7a_h" value="(a) Entropy Concentration by Block (violin)" style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontStyle=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1000" y="605" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c7a_plot" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="638" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c7b_h" value="(b) Entropy vs. Variance-Based Concentration" style="text;html=0;align=left;verticalAlign=top;fontSize=11;fontStyle=1;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1290" y="605" width="270" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c7b_plot" value="" style="shape=image;image=data:image/png,;imageAspect=0;aspect=fixed;html=1;" vertex="1" parent="1">
          <mxGeometry x="1290" y="638" width="270" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c7_obs" value="Key observations (real data, --save-latents pilot: 24 concepts &#215; 5 blocks &#215; 3 timesteps, seed 42, SD3):&#10;&#8226; entropy-based and variance-based concentration are essentially uncorrelated (r=0.03) &#8212; they measure different things, not interchangeable&#10;&#8226; entropy-based concentration rises with block depth (median ~0.010 at block 4 &#8594; ~0.015 at block 20) &#8212; later blocks host more spatially peaked latents" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;spacing=8;fontFamily=Segoe UI;" vertex="1" parent="1">
          <mxGeometry x="1000" y="790" width="560" height="100" as="geometry" />
        </mxCell>

